# Instagram Analytics — optional deployment credentials
#
# Vercel cannot fetch Instagram directly from its datacenter IPs. Set both values
# below to route public lookups through the authenticated local proxy endpoint
# exposed by a free Cloudflare Tunnel. The same PROXY_SECRET must be used here and
# in Vercel. Never commit the real secret.
INSTAGRAM_PROXY_URL=https://analytics-proxy.YOUR_DOMAIN/api/instagram-proxy
PROXY_SECRET=

# Optional official Meta Business Discovery path. Not required for username-only
# public lookup. Set both to enable it.
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
IG_GRAPH_VERSION=v27.0
