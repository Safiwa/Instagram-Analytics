# Instagram Analytics — optional deployment credentials
#
# Vercel cannot fetch Instagram directly from its datacenter IPs. Set both values
# below to route public lookups through the authenticated local proxy endpoint
# exposed by a free Cloudflare Tunnel. The same PROXY_SECRET must be used here and
# in Vercel. Never commit the real secret.
INSTAGRAM_PROXY_URL=https://analytics-proxy.instagram-analytics.com/api/instagram-proxy
PROXY_SECRET=

# Optional official Meta Business Discovery path. Not required for username-only
# public lookup. Set both to enable it.
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
IG_GRAPH_VERSION=v27.0

# Weekly digest (free 30-day trial)
# Required to send the Monday email. SMTP_FROM defaults to SMTP_USER when omitted.
# For providers that require SSL on 465, SMTP_SECURE=true is set automatically.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false

# Vercel Cron calls /api/digest/send with: Authorization: Bearer $CRON_SECRET
CRON_SECRET=

# Durable signup storage on Vercel. Create a Cloudflare KV namespace and bind these
# values. Without them, local development stores signups in .data/digest-subscriptions.json.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
DIGEST_KV_NAMESPACE_ID=
