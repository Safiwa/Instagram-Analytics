# Trending Analytics — optional deployment credentials
#
# Optional. Only needed when the app runs on a cloud host whose IP is
# rate-limited by Instagram (for example Vercel). Get 1,000 free credits at
# https://www.scrapingbee.com/ and paste the key into Vercel's Environment
# Variables UI. Never commit the real key.
SCRAPINGBEE_API_KEY=

# Optional official Meta Business Discovery path. Not required for username-only
# public lookup. Set both to enable it.
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
IG_GRAPH_VERSION=v27.0
