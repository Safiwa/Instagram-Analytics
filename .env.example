# Instagram Analytics — optional deployment credentials
#
# Vercel cannot fetch Instagram directly from its datacenter IPs. Set both values
# below to route public lookups through the authenticated local proxy endpoint
# exposed by a free Cloudflare Tunnel. The same PROXY_SECRET must be used here and
# in Vercel. Never commit the real secret.
INSTAGRAM_PROXY_URL=https://analytics-proxy.instagram-analytics.com/api/instagram-proxy
PROXY_SECRET=

# Optional official Meta Business Discovery path. Not required for username-only
# public lookup. Set both to enable it.
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
IG_GRAPH_VERSION=v27.0

# Weekly digest (free 30-day trial, display only)
# Resend sends the Monday email. DIGEST_FROM_EMAIL must be a verified sender.
RESEND_API_KEY=
DIGEST_FROM_EMAIL=

# Upstash Redis REST credentials store email + handle signups durably on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Cron calls /api/digest/send with Authorization: Bearer $CRON_SECRET.
# The same value signs unsubscribe links.
CRON_SECRET=

# In-house history database (optional). Neon Postgres connection string; Vercel
# adds it automatically when a Neon database is connected under Storage. Run
# `npm run db:migrate` once after setting it. The daily /api/collect cron also
# uses CRON_SECRET above.
DATABASE_URL=

# Local development only: override the default .data/digest-subscriptions.json path.
DIGEST_STORE_PATH=
