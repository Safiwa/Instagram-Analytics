# Signal — optional official Instagram API credentials
#
# Username lookup reads Instagram's public profile pages by default and needs
# no credentials. The official API path (Business Discovery) is optional and is
# used only when both values below are set; public web data remains the fallback.
#
# Copy this file to .env.local only if you want the official API path.
# Never commit .env.local.

# Long-lived Facebook user access token for the account that manages the Page.
IG_ACCESS_TOKEN=

# Instagram Business Account ID that performs the Business Discovery query.
# This is the app owner's professional account, not the handle being analyzed.
IG_BUSINESS_ACCOUNT_ID=

# Optional Graph API version. Defaults to v27.0 when omitted.
IG_GRAPH_VERSION=v27.0
