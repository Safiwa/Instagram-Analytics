{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "schedules": {
    "weekly-digest": {
      "schedule": "0 8 * * 1",
      "path": "/api/digest/send",
      "requestMethod": "GET"
    },
    "daily-collector": {
      "schedule": "15 2 * * *",
      "path": "/api/collect",
      "requestMethod": "GET"
    }
  }
}
